msgid "Access denied · check Settings"
msgstr "Доступ запрещён · проверьте настройки"

msgid "Access token rejected · check Settings"
msgstr "Токен отклонён · проверьте настройки"

msgid "Active"
msgstr "Активно"

msgid "Add a home icon next to the system indicators."
msgstr "Значок дома рядом с системными индикаторами."

msgid "Add an access token in Settings"
msgstr "Добавьте токен доступа в настройках"

msgid "All types"
msgstr "Все типы"

msgid "Available devices"
msgstr "Доступные устройства"

msgid "Binary sensors"
msgstr "Двоичные датчики"

msgid "Brightness"
msgstr "Яркость"

msgid "Brightness, fan speed, and cover position when supported."
msgstr "Яркость, скорость вентилятора и положение штор, если поддерживаются."

msgid "Buttons"
msgstr "Кнопки"

msgid "Check the server address, network, and TLS certificate, then try again."
msgstr "Проверьте адрес сервера, подключение к сети и сертификат TLS, затем повторите попытку."

msgid "Choose devices"
msgstr "Выберите устройства"

msgid "Choose devices from the list below."
msgstr "Выберите устройства из списка ниже."

msgid "Choose devices in Settings"
msgstr "Выберите устройства в настройках"

msgid "Climate"
msgstr "Климат"

msgid "Close"
msgstr "Закрыть"

msgid "Closed"
msgstr "Закрыто"

msgid "Closing"
msgstr "Закрывается"

msgid "Connect to Home Assistant first"
msgstr "Сначала подключитесь к Home Assistant"

msgid "Connect to your Home Assistant server to choose and control devices."
msgstr "Подключитесь к серверу Home Assistant для выбора устройств и управления ими."

msgid "Connected"
msgstr "Подключено"

msgid "Connected. Choose your devices."
msgstr "Подключено. Выберите устройства."

msgid "Connecting…"
msgstr "Подключение…"

msgid "Connection"
msgstr "Подключение"

msgid "Connection failed"
msgstr "Не удалось подключиться"

msgid "Could not access the GNOME keyring. Unlock your login keyring and try again."
msgstr "Не удалось открыть связку ключей GNOME. Разблокируйте связку ключей входа и повторите попытку."

msgid "Could not open Home Assistant."
msgstr "Не удалось открыть Home Assistant."

msgid "Could not read the GNOME keyring"
msgstr "Не удалось прочитать связку ключей GNOME"

msgid "Could not remove the saved token."
msgstr "Не удалось удалить сохранённый токен."

msgid "Covers"
msgstr "Шторы и жалюзи"

msgid "Create it in Home Assistant → Profile → Security. Leave the token field empty to keep the saved token for this URL."
msgstr "Создайте токен в Home Assistant → Профиль → Безопасность. Оставьте поле пустым, чтобы использовать сохранённый токен для этого адреса."

msgid "Custom name (empty uses Home Assistant name)"
msgstr "Своё название (пусто — название из Home Assistant)"

msgid "Decrease temperature"
msgstr "Уменьшить температуру"

msgid "Device type"
msgstr "Тип устройства"

msgid "Devices"
msgstr "Устройства"

msgid "Enter a valid http:// or https:// server URL without credentials, query, or fragment."
msgstr "Введите адрес сервера с http:// или https:// без логина, пароля, параметров запроса и фрагмента."

msgid "Enter an access token for this server."
msgstr "Введите токен доступа для этого сервера."

msgid "Example: http://homeassistant.local:8123"
msgstr "Например: http://homeassistant.local:8123"

msgid "Expand a device to rename it. Use the arrows to change its position."
msgstr "Раскройте устройство, чтобы изменить название. Стрелки меняют порядок в меню."

msgid "Fans"
msgstr "Вентиляторы"

msgid "Find devices"
msgstr "Найти устройства"

msgid "Forget"
msgstr "Забыть"

msgid "Forget connection"
msgstr "Забыть подключение"

msgid "Helpers"
msgstr "Помощники"

msgid "Home Assistant rejected this token. Create a new long-lived access token."
msgstr "Home Assistant отклонил токен. Создайте новый долгосрочный токен доступа."

msgid "In Quick Settings"
msgstr "В быстрых настройках"

msgid "Inactive"
